<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <PackageGroup Id="BundlePackages">
      <BundlePackage Id="BundleE" SourceFile="$(var.BundleE.TargetPath)" Compressed="yes" ExternalPayloadsCompressed="no" />
      <BundlePackage Id="BundleF" SourceFile="$(var.BundleF.TargetPath)" Compressed="yes"/>
    </PackageGroup>
  </Fragment>
</Wix>

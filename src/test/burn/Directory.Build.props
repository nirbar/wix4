<Project>
  <PropertyGroup>
    <SegmentName>IntegrationBurn</SegmentName>
    <SegmentName Condition=" '$(MSBuildProjectFile)' == 'WixToolset.Burn.UnitTest.csproj' ">BurnUnitTest</SegmentName>
    <SegmentName Condition=" '$(MSBuildProjectFile)' == 'WixToolsetTest.BurnUnitTest.csproj' ">BurnUnitTest</SegmentName>
    <SegmentName Condition=" '$(MSBuildProjectFile)' == 'WixToolsetTest.BurnUnitTest.BundleC_x64.csproj' ">BurnUnitTest</SegmentName>

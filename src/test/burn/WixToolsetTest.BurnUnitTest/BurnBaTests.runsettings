<?xml version="1.0" encoding="utf-8"?>
<!--
  Run settings for WixToolsetTest.BurnUnitTest.
  Customize BundlePath and Password to point at the bundle under test.
-->
<RunSettings>
  <RunConfiguration>
    <!-- Tell vstest to look for the burn BA test adapter in the test output directory. -->
    <TestAdaptersPaths>.</TestAdaptersPaths>
  </RunConfiguration>
  <BurnBATestFramework>
    <!-- Path to the bundle executable to test. Override at CI or locally. -->
    <BundlePath>$(OutputPath)TestBundle.exe</BundlePath>
    <!-- Optional password; leave empty to use the default. -->
    <Password></Password>
  </BurnBATestFramework>
</RunSettings>

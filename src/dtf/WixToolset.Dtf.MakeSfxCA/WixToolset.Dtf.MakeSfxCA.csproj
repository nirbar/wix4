<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net472;netstandard2.0</TargetFrameworks>
    <GenerateRuntimeConfigurationFiles Condition=" '$(TargetFramework)' == 'netstandard2.0' ">true</GenerateRuntimeConfigurationFiles>

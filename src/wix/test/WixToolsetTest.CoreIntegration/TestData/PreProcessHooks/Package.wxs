<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="PreProcessHooks" Language="1033" Version="1.0.0.0" Manufacturer="Example Corporation" UpgradeCode="3d8b6f0e-6a0f-4a8e-9f59-6f1d2f7b8a11" Compressed="no" Scope="perMachine">
    <Feature Id="ProductFeature" Title="Feature">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="PreProcessHooks" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component>
        <File Id="SignedFile" Source="sign_example.txt" />
      </Component>
      <Component>
        <File Id="PlainFile" Source="plain.txt" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
